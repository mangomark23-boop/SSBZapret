{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSBZapret",
  "version": "0.1.0",
  "identifier": "com.ssb.zapret",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SSBZapret",
        "width": 1100,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "tooltip": "SSBZapret",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMkQ2NjI0OTNDQjI2MjgKUldRb0pzdVRKR1l0ZlVXSUNxMGl3RUN4S1FBSjdOc3FjcUkvcWxyN1hJVjRzd1RxcVppTTNlSXMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
